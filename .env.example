# PasskeyGuard Environment Variables Template
# Copy this to frontend/.env.local and fill in the values

# ─── RPC ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ARBITRUM_SEPOLIA_RPC_URL="https://sepolia-rollup.arbitrum.io/rpc"

# ─── WalletConnect ───────────────────────────────────────────────────────────
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID="0a2662ef1b92e6471d69bb02b2cfd9a4"

# ─── Contract Addresses (fill after running deploy scripts) ──────────────────
NEXT_PUBLIC_VERIFIER_ADDRESS=""
NEXT_PUBLIC_POLICY_MANAGER_ADDRESS=""
NEXT_PUBLIC_PASSKEY_ACCOUNT_ADDRESS=""
NEXT_PUBLIC_DEMO_TARGET_ADDRESS=""

# ─── The Graph (Subgraph Studio URL) ─────────────────────────────────────────
# Format: https://api.studio.thegraph.com/query/<ID>/passkeyguard/version/latest
NEXT_PUBLIC_GRAPH_STUDIO_URL=""

# ─── Pinata (server-side) ────────────────────────────────────────────────────
PINATA_JWT=""
NEXT_PUBLIC_PINATA_GATEWAY="https://gateway.pinata.cloud"

# ─── Deployment Private Key (NEVER expose to client) ─────────────────────────
# Only needed for running deploy scripts
PRIVATE_KEY=""
